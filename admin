<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<meta http-equiv="Cache-Control" content="no-store">
<title>مدیریت کیهان | Kayhan Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#070b16;--panel:#101a2d;--line:#263650;--text:#edf4ff;--muted:#8fa0bd;--cyan:#73dcff;--violet:#a99aff;--green:#77e0bd;--red:#ff879b}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 15% 0,#1a2850 0,transparent 42%),var(--bg);color:var(--text);font-family:Vazirmatn,system-ui,sans-serif}
button,input{font:inherit}.wrap{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:34px 0 60px}
header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:28px}.brand{display:flex;align-items:center;gap:12px}.mark{width:46px;height:46px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(135deg,#73dcff,#a99aff);color:#07101d;font-size:22px;font-weight:900;box-shadow:0 8px 30px #73dcff33}h1{font-size:21px;margin:0}header p{margin:3px 0 0;color:var(--muted);font-size:12px}
.panel{background:linear-gradient(145deg,#121e34ed,#0b1325ed);border:1px solid var(--line);border-radius:22px;box-shadow:0 24px 70px #0005}
.login{max-width:430px;margin:9vh auto;padding:30px}.login h2{margin:0 0 8px}.muted{color:var(--muted);font-size:13px;line-height:1.9}.field{display:grid;gap:8px;margin:22px 0 14px}.field label{font-size:12px;color:#c5d2e8}.field input{width:100%;border:1px solid #334662;border-radius:12px;background:#081222;color:white;padding:13px 14px;outline:0}.field input:focus{border-color:var(--cyan);box-shadow:0 0 0 3px #73dcff18}
.btn{border:1px solid #ffffff1c;background:#172943;color:var(--text);border-radius:12px;padding:11px 16px;cursor:pointer;transition:.2s}.btn:hover{border-color:var(--cyan);transform:translateY(-1px)}.primary{background:linear-gradient(120deg,#5cccf0,#a6a0ff);color:#06101b;border:0;font-weight:800}.wide{width:100%}.error{color:var(--red);font-size:12px;min-height:20px;margin:10px 0 0}
.hidden{display:none!important}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar .muted{margin-inline-end:auto}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:18px 0}.stat{padding:20px}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;font-size:30px;letter-spacing:.3px;margin-top:8px;direction:ltr;text-align:right}.stat small{color:var(--muted);font-size:10px}
.columns{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.section{padding:20px;min-width:0}.section h3{font-size:14px;margin:0 0 15px}.bars{display:grid;gap:13px}.barrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;font-size:12px}.barname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#d6e1f3;direction:ltr;text-align:right}.bartrack{grid-column:1/-1;height:7px;border-radius:20px;background:#ffffff0c;overflow:hidden}.barfill{height:100%;border-radius:20px;background:linear-gradient(90deg,#73dcff,#a99aff)}
table{width:100%;border-collapse:collapse;font-size:12px}td,th{text-align:right;padding:11px 8px;border-bottom:1px solid #ffffff12}th{color:var(--muted);font-weight:500}td{color:#dbe6f7}.ltr{direction:ltr;text-align:left;font-variant-numeric:tabular-nums}
.note{padding:13px 15px;border:1px solid #73dcff2c;background:#73dcff0b;border-radius:13px;color:#bcd3e8;font-size:11px;line-height:1.9;margin-top:16px}
@media(max-width:800px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.columns{grid-template-columns:1fr}}
@media(max-width:480px){.wrap{width:calc(100% - 20px);padding-top:20px}.login{margin-top:7vh;padding:22px}.stat{padding:14px}.stat strong{font-size:24px}header{align-items:flex-start}}
</style>
</head>
<body>
<main class="wrap">
  <section id="loginView" class="panel login">
    <div class="brand"><div class="mark">✦</div><div><h1>کیهان / مدیریت</h1><p>ورود مدیر سامانه</p></div></div>
    <h2 style="margin-top:28px">خوش برگشتی</h2>
    <p class="muted">این صفحه مستقل از رابط عمومی سایت است. برای ورود، رمز مدیریت را وارد کن.</p>
    <form id="loginForm">
      <div class="field"><label for="password">رمز عبور مدیر</label><input id="password" type="password" autocomplete="current-password" required autofocus></div>
      <button class="btn primary wide" id="loginBtn">ورود امن به پنل</button><p id="loginError" class="error" role="alert"></p>
    </form>
  </section>

  <section id="dashboard" class="hidden">
    <header><div class="brand"><div class="mark">✦</div><div><h1>داشبورد مدیریت کیهان</h1><p>آمار بازدید و عملکرد وب‌سایت</p></div></div><div class="toolbar"><button class="btn" id="refresh">به‌روزرسانی آمار</button><button class="btn" id="logout">خروج</button></div></header>
    <div class="toolbar"><span class="muted" id="updated">در انتظار دریافت آمار…</span></div>
    <div class="grid">
      <article class="panel stat"><span>کل بازدیدها</span><strong id="total">—</strong><small>از زمان راه‌اندازی شمارنده</small></article>
      <article class="panel stat"><span>بازدید امروز</span><strong id="today">—</strong><small>بر اساس زمان UTC سرور</small></article>
      <article class="panel stat"><span>۷ روز اخیر</span><strong id="week">—</strong><small>مجموع بازدید صفحات</small></article>
      <article class="panel stat"><span>صفحات ثبت‌شده</span><strong id="pages">—</strong><small>مسیرهای دارای بازدید</small></article>
    </div>
    <div class="columns">
      <section class="panel section"><h3>بازدید روزانه · ۷ روز اخیر</h3><div id="daily" class="bars"></div></section>
      <section class="panel section"><h3>صفحات پربازدید</h3><div id="topPages" class="bars"></div></section>
    </div>
    <section class="panel section" style="margin-top:14px"><h3>آخرین بازدیدهای ثبت‌شده</h3><div style="overflow:auto"><table><thead><tr><th>صفحه</th><th>زمان ثبت</th></tr></thead><tbody id="recent"></tbody></table></div></section>
    <p class="note">این پنل فقط آمار درخواست‌هایی را نشان می‌دهد که پس از اتصال سرویس آمار ثبت شده‌اند. بازدیدهای قبل از نصب شمارنده قابل بازیابی نیستند. شمارش بر اساس بارگذاری صفحه است و الزاماً معادل تعداد افراد یکتا نیست.</p>
  </section>
</main>
<script src="../kayhan-config.js"></script>
<script>
(() => {
 const api=(window.KAYHAN_API_BASE||"").replace(/\/+$/,"");
 const $=id=>document.getElementById(id);
 let token=sessionStorage.getItem("kayhan_admin_token")||"";
 const fmt=n=>Number(n||0).toLocaleString("fa-IR");
 function showDashboard(){ $("loginView").classList.add("hidden");$("dashboard").classList.remove("hidden");loadStats(); }
 function showLogin(){ $("dashboard").classList.add("hidden");$("loginView").classList.remove("hidden"); }
 async function request(path,options={}) {
   if(!api || api.includes("YOUR-WORKER")) throw new Error("ابتدا آدرس Worker را در فایل kayhan-config.js تنظیم کن.");
   const headers={...(options.headers||{})}; if(token) headers.Authorization="Bearer "+token;
   const res=await fetch(api+path,{...options,headers});
   const data=await res.json().catch(()=>({error:"پاسخ نامعتبر سرور"}));
   if(!res.ok) throw new Error(data.error||"خطا در ارتباط با سرور");
   return data;
 }
 $("loginForm").addEventListener("submit",async e=>{
   e.preventDefault();$("loginError").textContent="";$("loginBtn").disabled=true;
   try {const d=await request("/api/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password:$("password").value})});token=d.token;sessionStorage.setItem("kayhan_admin_token",token);$("password").value="";showDashboard();}
   catch(err){$("loginError").textContent=err.message;}
   finally{$("loginBtn").disabled=false;}
 });
 async function loadStats(){
   $("updated").textContent="در حال دریافت…";
   try{
     const d=await request("/api/stats");
     $("total").textContent=fmt(d.total);$("today").textContent=fmt(d.today);$("week").textContent=fmt(d.last7Days);$("pages").textContent=fmt(d.pages ?? d.topPages.length);
     const daily=d.daily||[],max=Math.max(1,...daily.map(x=>x.views));
     $("daily").innerHTML=daily.map(x=>`<div class="barrow"><span>${x.day}</span><b>${fmt(x.views)}</b><div class="bartrack"><div class="barfill" style="width:${Math.max(2,x.views/max*100)}%"></div></div></div>`).join("")||'<p class="muted">هنوز داده‌ای ثبت نشده است.</p>';
     const pages=d.topPages||[],pmax=Math.max(1,...pages.map(x=>x.views));
     $("topPages").innerHTML=pages.map(x=>`<div class="barrow"><span class="barname">${escapeHtml(x.path)}</span><b>${fmt(x.views)}</b><div class="bartrack"><div class="barfill" style="width:${Math.max(2,x.views/pmax*100)}%"></div></div></div>`).join("")||'<p class="muted">هنوز داده‌ای ثبت نشده است.</p>';
     $("recent").innerHTML=(d.recent||[]).map(x=>`<tr><td class="ltr">${escapeHtml(x.path)}</td><td class="ltr">${new Date(x.visitedAt).toLocaleString("fa-IR")}</td></tr>`).join("")||'<tr><td colspan="2">هنوز بازدیدی ثبت نشده است.</td></tr>';
     $("updated").textContent="آخرین به‌روزرسانی: "+new Date().toLocaleTimeString("fa-IR");
   }catch(err){$("updated").textContent=err.message;if(/نشست|ورود|مجاز|token/i.test(err.message)){token="";sessionStorage.removeItem("kayhan_admin_token");showLogin();}}
 }
 function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
 $("refresh").onclick=loadStats;
 $("logout").onclick=async()=>{try{await request("/api/logout",{method:"POST"})}catch(_){}token="";sessionStorage.removeItem("kayhan_admin_token");showLogin();};
 if(token)showDashboard();else showLogin();
})();
</script>
</body></html>
